<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon">
    <XamlUICommand
        x:Key="ShowWindowCommand"
        Description="Open Codex Decision"
        Label="Open Codex Decision">
        <XamlUICommand.IconSource>
            <SymbolIconSource Symbol="OpenPane" />
        </XamlUICommand.IconSource>
    </XamlUICommand>
    <XamlUICommand
        x:Key="RefreshCommand"
        Description="Read the newest local Codex limit"
        Label="Refresh">
        <XamlUICommand.IconSource>
            <SymbolIconSource Symbol="Refresh" />
        </XamlUICommand.IconSource>
    </XamlUICommand>
    <XamlUICommand
        x:Key="ExitApplicationCommand"
        Description="Exit Codex Decision"
        Label="Exit">
        <XamlUICommand.IconSource>
            <SymbolIconSource Symbol="ClosePane" />
        </XamlUICommand.IconSource>
    </XamlUICommand>

    <tb:TaskbarIcon
        x:Key="TrayIcon"
        ContextMenuMode="PopupMenu"
        IconSource="\Assets\CodexMeter.ico"
        LeftClickCommand="{StaticResource ShowWindowCommand}"
        NoLeftClickDelay="True"
        ToolTipText="Codex weekly · reading local usage"
        Visibility="Visible">
        <tb:TaskbarIcon.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem Command="{StaticResource ShowWindowCommand}" />
                <MenuFlyoutItem Command="{StaticResource RefreshCommand}" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Command="{StaticResource ExitApplicationCommand}" />
            </MenuFlyout>
        </tb:TaskbarIcon.ContextFlyout>
    </tb:TaskbarIcon>
</ResourceDictionary>
