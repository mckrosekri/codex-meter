<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="CodexMeterTray.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CodexMeterTray.Views"
    Background="{StaticResource AppBackgroundBrush}">
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="ContextColumn" Width="312" />
        </Grid.ColumnDefinitions>

        <Grid MinWidth="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="20,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="1">
                    <TextBlock
                        x:Name="TaskTitleText"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AppTextBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="WorkingDirectoryText"
                        FontSize="10"
                        Foreground="{StaticResource AppFaintBrush}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                    <Button
                        x:Name="StopButton"
                        Style="{StaticResource ToolbarButtonStyle}"
                        AutomationProperties.Name="Stop current Codex turn"
                        Click="StopButton_Click"
                        Content="Stop"
                        IsEnabled="False" />
                    <Button
                        x:Name="ActivityPaneButton"
                        Style="{StaticResource ToolbarButtonStyle}"
                        AutomationProperties.Name="Hide task context pane"
                        Click="ToggleActivityPane_Click"
                        Content="Details" />
                    <Button Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="Open task environment" Content="Open in">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="OpenTerminal_Click" Text="Terminal" />
                                <MenuFlyoutItem Click="OpenEditor_Click" Text="Editor" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" AutomationProperties.Name="More task actions" Content="•••">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="CompactButton_Click" Text="Compact conversation context" />
                                <MenuFlyoutItem Click="ForkButton_Click" Text="Branch conversation" />
                                <MenuFlyoutItem Click="ContinueFreshButton_Click" Text="Continue in a fresh task" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="GitReviewButton_Click" Text="Review Git changes" />
                                <MenuFlyoutItem Click="UndoCheckpointButton_Click" Text="Undo last turn changes" />
                                <MenuFlyoutItem Click="RedoCheckpointButton_Click" Text="Redo last turn changes" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="ExportButton_Click" Text="Export conversation" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>

            <InfoBar
                x:Name="RouteInfoBar"
                Grid.Row="1"
                Margin="20,0,20,8"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational" />

            <ListView
                x:Name="TimelineList"
                Grid.Row="2"
                Padding="24,20,24,16"
                AutomationProperties.Name="Codex conversation"
                IsItemClickEnabled="False"
                IsTabStop="False"
                ItemsSource="{x:Bind Timeline, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="IsTabStop" Value="False" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,20" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TimelineEntry">
                        <Grid HorizontalAlignment="Stretch">
                            <StackPanel
                                MaxWidth="760"
                                HorizontalAlignment="Left"
                                Spacing="6"
                                Visibility="{x:Bind AssistantVisibility}">
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AppFaintBrush}"
                                    Text="{x:Bind Role}" />
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{StaticResource AppTextBrush}"
                                    IsTextSelectionEnabled="True"
                                    LineHeight="22"
                                    Text="{x:Bind Text, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Border
                                MaxWidth="540"
                                Padding="14,10"
                                HorizontalAlignment="Right"
                                Background="{StaticResource AppElevatedBrush}"
                                CornerRadius="14"
                                Visibility="{x:Bind UserVisibility}">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AppFaintBrush}"
                                        Text="{x:Bind Role}" />
                                    <TextBlock
                                        FontSize="14"
                                        Foreground="{StaticResource AppTextBrush}"
                                        IsTextSelectionEnabled="True"
                                        LineHeight="21"
                                        Text="{x:Bind Text, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border
                                MaxWidth="760"
                                HorizontalAlignment="Stretch"
                                Background="{StaticResource AppSurfaceBrush}"
                                BorderBrush="{StaticResource AppLineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Visibility="{x:Bind FileChangesVisibility}">
                                <StackPanel>
                                    <Grid Padding="12,10" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="34"
                                            Height="34"
                                            Background="{StaticResource AppElevatedBrush}"
                                            CornerRadius="8">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="14"
                                                Glyph="&#xE8B7;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Text}" />
                                            <Button
                                                Padding="0"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.Name="Review changed files"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="GitReviewButton_Click"
                                                Content="Review changes ↗"
                                                FontSize="11"
                                                Foreground="{StaticResource AppMutedBrush}" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Undo the latest turn changes"
                                            Click="UndoCheckpointButton_Click"
                                            Content="Undo all"
                                            Style="{StaticResource ToolbarButtonStyle}" />
                                        <Button
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Review Git changes"
                                            Click="GitReviewButton_Click"
                                            Content="Review"
                                            Style="{StaticResource ToolbarButtonStyle}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{x:Bind FileChanges}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:FileChangeLine">
                                                <Grid
                                                    MinHeight="36"
                                                    Padding="12,6"
                                                    BorderBrush="{StaticResource AppLineBrush}"
                                                    BorderThickness="0,1,0,0"
                                                    ColumnSpacing="5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Text="{x:Bind Path}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{StaticResource AppGoodBrush}"
                                                        Text="{x:Bind AdditionText}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="11"
                                                        Foreground="{StaticResource AppDangerBrush}"
                                                        Text="{x:Bind DeletionText}" />
                                                    <Button
                                                        Grid.Column="3"
                                                        MinHeight="28"
                                                        Padding="8,2"
                                                        VerticalAlignment="Center"
                                                        AutomationProperties.Name="{x:Bind UndoAutomationName}"
                                                        Click="UndoFileButton_Click"
                                                        Content="{x:Bind UndoLabel, Mode=OneWay}"
                                                        IsEnabled="{x:Bind CanUndo, Mode=OneWay}"
                                                        Style="{StaticResource ToolbarButtonStyle}"
                                                        ToolTipService.ToolTip="Undo only this file" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                x:Name="QueuePanel"
                Grid.Row="2"
                MaxWidth="820"
                Margin="22,0,22,8"
                Padding="12,9"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Bottom"
                Background="{StaticResource AppElevatedBrush}"
                BorderBrush="{StaticResource AppLineBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Visibility="Collapsed">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="QueueStatusText"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AppMutedBrush}" />
                        <Button
                            x:Name="ResumeQueueButton"
                            Grid.Column="1"
                            Padding="8,2"
                            AutomationProperties.Name="Run the next queued message"
                            Click="ResumeQueueButton_Click"
                            Content="Run next"
                            Visibility="Collapsed" />
                    </Grid>
                    <ScrollViewer
                        Grid.Row="1"
                        MaxHeight="160"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl
                            AutomationProperties.Name="Queued follow-up messages"
                            ItemsSource="{x:Bind QueuedFollowUps, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:QueuedFollowUpView">
                                    <Grid
                                        MinHeight="42"
                                        Padding="4,5"
                                        ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            MinWidth="18"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{StaticResource AppFaintBrush}"
                                            Text="{x:Bind PositionLabel}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock
                                                MaxLines="2"
                                                Foreground="{StaticResource AppTextBrush}"
                                                Text="{x:Bind Prompt}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                MaxLines="1"
                                                FontSize="9"
                                                Foreground="{StaticResource AppFaintBrush}"
                                                Text="{x:Bind RouteLabel}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                            <Button
                                                Padding="9,3"
                                                AutomationProperties.Name="Steer the active turn with this queued message"
                                                Click="SteerQueued_Click"
                                                Content="Steer"
                                                Tag="{x:Bind Id}" />
                                            <Button
                                                Padding="9,3"
                                                AutomationProperties.Name="Edit queued message"
                                                Click="EditQueued_Click"
                                                Content="Edit"
                                                Tag="{x:Bind Id}" />
                                            <Button
                                                Width="32"
                                                Padding="0"
                                                AutomationProperties.Name="More queued message actions"
                                                Content="&#x2026;">
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem
                                                            Click="MoveQueuedUp_Click"
                                                            IsEnabled="{x:Bind CanMoveUp}"
                                                            Tag="{x:Bind Id}"
                                                            Text="Move up" />
                                                        <MenuFlyoutItem
                                                            Click="MoveQueuedDown_Click"
                                                            IsEnabled="{x:Bind CanMoveDown}"
                                                            Tag="{x:Bind Id}"
                                                            Text="Move down" />
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem
                                                            Click="DeleteQueued_Click"
                                                            Tag="{x:Bind Id}"
                                                            Text="Delete" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border
                x:Name="ComposerBorder"
                Grid.Row="3"
                MaxWidth="820"
                Margin="22,0,22,18"
                Padding="12,8,12,10"
                AllowDrop="True"
                DragOver="Composer_DragOver"
                Drop="Composer_Drop"
                HorizontalAlignment="Stretch"
                Background="{StaticResource AppComposerBrush}"
                BorderBrush="{StaticResource AppLineBrush}"
                BorderThickness="1"
                CornerRadius="16"
                ToolTipService.ToolTip="Drop files anywhere in this composer to attach them.">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        x:Name="GoalPanel"
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        Padding="0,8,0,8"
                        BorderBrush="{StaticResource AppLineBrush}"
                        BorderThickness="0,1,0,1"
                        Spacing="6"
                        Visibility="Collapsed">
                        <TextBox x:Name="GoalOutcomeBox" AutomationProperties.Name="Goal outcome" Header="Outcome" PlaceholderText="What must be true when this task is done?" />
                        <TextBox x:Name="GoalConstraintsBox" AutomationProperties.Name="Goal constraints" Header="Constraints" PlaceholderText="Boundaries, compatibility, and approaches to avoid" />
                        <TextBox x:Name="GoalVerificationBox" AutomationProperties.Name="Goal verification" Header="Verification" PlaceholderText="Tests or evidence that prove completion" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="SaveGoalButton_Click" Content="Save goal" Style="{StaticResource AccentButtonStyle}" />
                            <Button Click="PauseGoalButton_Click" Content="Pause / resume" />
                            <Button Click="ClearGoalButton_Click" Content="Clear" />
                        </StackPanel>
                    </StackPanel>

                    <Grid
                        x:Name="AttachmentPanel"
                        Grid.Row="1"
                        Margin="0,0,0,8"
                        ColumnSpacing="8"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListView
                            x:Name="AttachmentList"
                            MaxHeight="58"
                            AutomationProperties.Name="Selected attachments"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{x:Bind Attachments, Mode=OneWay}"
                            SelectionMode="Single" />
                        <Button Grid.Column="1" Click="RemoveAttachment_Click" Content="Remove" />
                    </Grid>

                    <TextBox
                        x:Name="PromptBox"
                        Grid.Row="2"
                        Margin="0,0,0,10"
                        MinHeight="64"
                        MaxHeight="180"
                        AcceptsReturn="True"
                        AutomationProperties.Name="Message Codex"
                        Background="{StaticResource AppElevatedBrush}"
                        BorderThickness="0"
                        CornerRadius="9"
                        Padding="12,9"
                        KeyDown="PromptBox_KeyDown"
                        PlaceholderText="Ask Codex to change, explain, or review something"
                        TextWrapping="Wrap" />

                    <Grid x:Name="BottomControls" Grid.Row="3" ColumnSpacing="8" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer
                            x:Name="ComposerControlsScroller"
                            MinWidth="0"
                            HorizontalScrollBarVisibility="Auto"
                            HorizontalScrollMode="Enabled"
                            VerticalScrollMode="Disabled">
                            <Grid x:Name="DecisionControlsGrid" ColumnSpacing="7" RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="ModelCombo"
                                    Grid.Column="0"
                                    Style="{StaticResource ComposerComboBoxStyle}"
                                    MinHeight="32"
                                    MinWidth="190"
                                    AutomationProperties.Name="Model selection"
                                    DisplayMemberPath="Label"
                                    SelectionChanged="ModelCombo_SelectionChanged"
                                    ToolTipService.ToolTip="Adaptive delegates bounded phases to efficient models. One model keeps the whole turn on the initial Full Auto route." />
                                <Button x:Name="LockButton" Grid.Column="1" Style="{StaticResource ComposerControlStyle}" MinHeight="32" AutomationProperties.Name="Routing lock" Content="No lock">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Click="LockTask_Click" Text="Lock this task" />
                                            <MenuFlyoutItem Click="LockProject_Click" Text="Lock this project" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Click="UnlockTask_Click" Text="Unlock this task" />
                                            <MenuFlyoutItem Click="UnlockProject_Click" Text="Unlock this project" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                                <ComboBox x:Name="EffortCombo" Grid.Column="2" Style="{StaticResource ComposerComboBoxStyle}" MinHeight="32" MinWidth="104" AutomationProperties.Name="Reasoning effort" DisplayMemberPath="Label" SelectionChanged="DecisionSelector_SelectionChanged" />
                                <ComboBox x:Name="PermissionCombo" Grid.Column="3" Style="{StaticResource ComposerComboBoxStyle}" MinHeight="32" MinWidth="138" AutomationProperties.Name="Permission level" DisplayMemberPath="Label" SelectionChanged="DecisionSelector_SelectionChanged" />
                            </Grid>
                        </ScrollViewer>
                        <StackPanel
                            x:Name="ComposerActionPanel"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="7">
                            <Grid
                                x:Name="ContextMeterPanel"
                                Width="32"
                                Height="32"
                                AutomationProperties.Name="Conversation context pending"
                                ToolTipService.ToolTip="Context pending">
                                <ProgressRing
                                    x:Name="ContextProgressRing"
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsActive="False"
                                    Visibility="Collapsed" />
                                <Border
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    BorderBrush="{StaticResource AppMutedBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14">
                                    <TextBlock
                                        x:Name="ContextMeterGlyph"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        Foreground="{StaticResource AppMutedBrush}"
                                        Text="i" />
                                </Border>
                            </Grid>
                            <Button
                                x:Name="AddAttachmentButton"
                                Style="{StaticResource ComposerControlStyle}"
                                MinHeight="32"
                                Padding="9,3"
                                AutomationProperties.Name="Show goal mode"
                                Click="ToggleGoalButton_Click"
                                Content="Goal" />
                            <Button
                                Style="{StaticResource ComposerControlStyle}"
                                Width="32"
                                MinHeight="32"
                                Padding="0"
                                AutomationProperties.Name="Attach local files"
                                Click="AddAttachment_Click"
                                Content="+"
                                ToolTipService.ToolTip="Attach files" />
                            <Button
                                x:Name="TranscribeButton"
                                Style="{StaticResource ComposerControlStyle}"
                                MinHeight="32"
                                AutomationProperties.Name="Record a voice note for Codex"
                                Click="TranscribeButton_Click"
                                Content="Mic"
                                ToolTipService.ToolTip="Record a voice note for Codex to transcribe in the next message." />
                            <Button
                                x:Name="SendButton"
                                MinWidth="72"
                                MinHeight="32"
                                AutomationProperties.Name="Send message"
                                Click="SendButton_Click"
                                Content="Send"
                                Style="{StaticResource AccentButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid
            x:Name="ActivityPane"
            Grid.Column="1"
            Margin="10,12,14,14"
            RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Padding="12,10"
                Background="{StaticResource AppElevatedBrush}"
                BorderBrush="{StaticResource AppLineBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Spacing="2">
                    <Grid MinHeight="34" Padding="4,0" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource AppMutedBrush}" Text="Environment" />
                        <ProgressRing
                            x:Name="EnvironmentLoadingRing"
                            Grid.Column="1"
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            IsActive="False"
                            Visibility="Collapsed" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                            <Button
                                x:Name="RefreshEnvironmentButton"
                                Width="28"
                                Height="28"
                                Padding="0"
                                AutomationProperties.Name="Refresh environment"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="RefreshEnvironmentButton_Click">
                                <SymbolIcon Symbol="Refresh" />
                            </Button>
                            <Button
                                Width="28"
                                Height="28"
                                Padding="0"
                                AutomationProperties.Name="Hide task context pane"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="ToggleActivityPane_Click">
                                <SymbolIcon Symbol="ClosePane" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Button
                        x:Name="ChangesButton"
                        AutomationProperties.Name="Open Git changes"
                        Click="GitReviewButton_Click"
                        Style="{StaticResource EnvironmentRowButtonStyle}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon VerticalAlignment="Center" Symbol="Edit" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Changes" />
                                <TextBlock x:Name="ContextChangesText" FontSize="10" Foreground="{StaticResource AppFaintBrush}" Text="Checking working tree…" />
                            </StackPanel>
                            <TextBlock x:Name="ContextAdditionText" Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource AppGoodBrush}" Text="" />
                            <TextBlock x:Name="ContextDeletionText" Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource AppDangerBrush}" Text="" />
                        </Grid>
                    </Button>

                    <Button
                        AutomationProperties.Name="Open project location menu"
                        Style="{StaticResource EnvironmentRowButtonStyle}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="OpenProjectFolder_Click" Text="Open project folder" />
                                <MenuFlyoutItem Click="OpenTerminal_Click" Text="Open in terminal" />
                                <MenuFlyoutItem Click="OpenEditor_Click" Text="Open in editor" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon VerticalAlignment="Center" Symbol="Folder" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="ContextLocationText" Text="Local" />
                                <TextBlock x:Name="ContextLocationDetailText" FontSize="10" Foreground="{StaticResource AppFaintBrush}" Text="Project folder" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="10"
                                Foreground="{StaticResource AppFaintBrush}"
                                Glyph="&#xE70D;" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="BranchButton"
                        AutomationProperties.Name="Open branch menu"
                        Style="{StaticResource EnvironmentRowButtonStyle}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="CopyBranch_Click" Text="Copy branch name" />
                                <MenuFlyoutItem Click="CreateBranch_Click" Text="Create branch" />
                                <MenuFlyoutItem Click="RefreshEnvironmentButton_Click" Text="Refresh branch" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon VerticalAlignment="Center" Symbol="Share" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="ContextBranchText" Text="Reading branch…" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ContextBranchDetailText" FontSize="10" Foreground="{StaticResource AppFaintBrush}" Text="Checking upstream" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="10"
                                Foreground="{StaticResource AppFaintBrush}"
                                Glyph="&#xE70D;" />
                        </Grid>
                    </Button>

                    <Button
                        x:Name="CommitPushButton"
                        AutomationProperties.Name="Commit or push"
                        Click="CommitPushButton_Click"
                        Style="{StaticResource EnvironmentRowButtonStyle}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon VerticalAlignment="Center" Symbol="Save" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Commit or push" />
                                <TextBlock x:Name="CommitPushDetailText" FontSize="10" Foreground="{StaticResource AppFaintBrush}" Text="Checking repository" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button
                        x:Name="CompareBranchButton"
                        AutomationProperties.Name="Compare branch"
                        Click="CompareBranchButton_Click"
                        Style="{StaticResource EnvironmentRowButtonStyle}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <SymbolIcon VerticalAlignment="Center" Symbol="Switch" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Compare branch" />
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="12"
                                Foreground="{StaticResource AppFaintBrush}"
                                Glyph="&#xE8A7;" />
                        </Grid>
                    </Button>

                    <Border Height="1" Margin="4,6" Background="{StaticResource AppLineBrush}" />
                    <TextBlock Margin="4,2,4,0" FontSize="11" Foreground="{StaticResource AppFaintBrush}" Text="Plan" />
                    <Grid MinHeight="36" Padding="4,2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon VerticalAlignment="Center" Symbol="Bullets" />
                        <TextBlock x:Name="ContextPlanText" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Text="No active goal" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </Grid>
                    <Border Height="1" Margin="4,6" Background="{StaticResource AppLineBrush}" />
                    <Grid MinHeight="38" Padding="4,2" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <SymbolIcon VerticalAlignment="Center" Symbol="Manage" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="ContextRouteText" FontSize="12" Text="Full Auto / Adaptive" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ContextSkillsText" FontSize="10" Foreground="{StaticResource AppFaintBrush}" Text="Special skills off" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Grid.Row="1"
                Padding="12,10"
                Background="{StaticResource AppElevatedBrush}"
                BorderBrush="{StaticResource AppLineBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Spacing="4">
                    <Grid MinHeight="30" Padding="4,0" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource AppMutedBrush}" Text="Work receipt" />
                        <Button
                            x:Name="RerunVerificationButton"
                            Grid.Column="1"
                            Width="28"
                            Height="28"
                            Padding="0"
                            AutomationProperties.Name="Run verification again"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="RerunVerificationButton_Click">
                            <SymbolIcon Symbol="Refresh" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            Width="28"
                            Height="28"
                            Padding="0"
                            AutomationProperties.Name="Configure verification gate"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="ConfigureVerificationGateButton_Click">
                            <SymbolIcon Symbol="Setting" />
                        </Button>
                    </Grid>

                    <Button
                        x:Name="WorkReceiptButton"
                        AutomationProperties.Name="Open latest work receipt"
                        Click="WorkReceiptButton_Click"
                        Style="{StaticResource EnvironmentRowButtonStyle}">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                x:Name="WorkReceiptStatusIcon"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="14"
                                Glyph="&#xE9D9;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                <TextBlock x:Name="WorkReceiptStatusText" Text="No receipt yet" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="WorkReceiptDetailText" FontSize="10" Foreground="{StaticResource AppFaintBrush}" Text="Recorded after a completed turn" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="10"
                                Foreground="{StaticResource AppFaintBrush}"
                                Glyph="&#xE76C;" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <Border
                Grid.Row="2"
                Padding="12,10"
                Background="{StaticResource AppSurfaceBrush}"
                BorderBrush="{StaticResource AppLineBrush}"
                BorderThickness="1"
                CornerRadius="14">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="Activity" />
                    <ListView
                        Grid.Row="1"
                        Padding="4,8"
                        AutomationProperties.Name="Codex activity"
                        IsTabStop="False"
                        ItemsSource="{x:Bind Activity, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ActivityEntry">
                                <StackPanel Margin="0,0,0,12" Spacing="3">
                                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AppMutedBrush}" Text="{x:Bind Kind}" />
                                    <TextBlock
                                        FontFamily="Cascadia Mono"
                                        FontSize="10"
                                        Foreground="{StaticResource AppTextBrush}"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind Text}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Expander Grid.Row="2" Header="Diff">
                        <TextBox
                            x:Name="DiffTextBox"
                            MinHeight="120"
                            Padding="10"
                            AutomationProperties.Name="Current turn diff"
                            BorderThickness="0"
                            FontFamily="Cascadia Mono"
                            FontSize="10"
                            IsReadOnly="True"
                            PlaceholderText="File changes will appear here."
                            TextWrapping="NoWrap" />
                    </Expander>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
