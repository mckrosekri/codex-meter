<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="CodexMeterTray.Views.GitReviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:git="using:CodexDecision.Core.Git"
    xmlns:local="using:CodexMeterTray.Views"
    Title="Git changes"
    CloseButtonText="Close">
    <Grid x:Name="ReviewRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="0,0,0,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock
                    x:Name="SummaryText"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="Loading repository changes…" />
                <ComboBox
                    x:Name="BaseBranchComboBox"
                    MaxWidth="320"
                    HorizontalAlignment="Left"
                    Header="Compare with"
                    AutomationProperties.Name="Branch to compare with"
                    SelectionChanged="BaseBranchComboBox_SelectionChanged"
                    Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        x:Name="BranchText"
                        Foreground="{StaticResource AppMutedBrush}"
                        FontSize="11"
                        Text="Reading branch" />
                    <TextBlock
                        Foreground="{StaticResource AppFaintBrush}"
                        FontSize="11"
                        Text="·" />
                    <TextBlock
                        x:Name="RepositoryText"
                        MaxWidth="620"
                        Foreground="{StaticResource AppFaintBrush}"
                        FontSize="11"
                        Text="Locating repository"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ProgressRing
                    x:Name="RepositoryLoadingRing"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    IsActive="False"
                    Visibility="Collapsed" />
                <Button
                    AutomationProperties.Name="Refresh Git changes"
                    Click="RefreshButton_Click"
                    Content="Refresh"
                    Style="{StaticResource ToolbarButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="1"
            Background="{StaticResource AppLineBrush}" />

        <Grid x:Name="BodyGrid" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="0" />
                <RowDefinition Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FileColumn" Width="300" />
                <ColumnDefinition x:Name="DividerColumn" Width="1" />
                <ColumnDefinition x:Name="DiffColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="FilePane" Padding="0,10,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Margin="8,0,8,8"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource AppMutedBrush}"
                    Text="Changed files" />
                <ListView
                    x:Name="FilesList"
                    Grid.Row="1"
                    AutomationProperties.Name="Changed files"
                    IsItemClickEnabled="False"
                    SelectionChanged="FilesList_SelectionChanged"
                    SelectionMode="Single"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="CornerRadius" Value="7" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="git:GitReviewFile">
                            <Grid
                                MinHeight="52"
                                Padding="8,6"
                                ColumnSpacing="7"
                                AutomationProperties.Name="{x:Bind AutomationName}"
                                ToolTipService.ToolTip="{x:Bind Path}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="24"
                                    Height="24"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource AppElevatedBrush}"
                                    CornerRadius="6">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AppMutedBrush}"
                                        Text="{x:Bind StatusGlyph}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind FileName}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{StaticResource AppFaintBrush}"
                                        Text="{x:Bind Directory}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{StaticResource AppGoodBrush}"
                                    Text="{x:Bind AdditionText}" />
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{StaticResource AppDangerBrush}"
                                    Text="{x:Bind DeletionText}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Border
                x:Name="PaneDivider"
                Grid.Column="1"
                Width="1"
                HorizontalAlignment="Center"
                Background="{StaticResource AppLineBrush}" />

            <Grid x:Name="DiffPane" Grid.Column="2" Padding="12,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="SelectedFileText"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Select a file"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="SelectedFileMetaText"
                            FontSize="10"
                            Foreground="{StaticResource AppMutedBrush}"
                            Text="Choose a changed file to inspect its diff." />
                    </StackPanel>
                    <ProgressRing
                        x:Name="DiffLoadingRing"
                        Grid.Column="1"
                        Width="20"
                        Height="20"
                        VerticalAlignment="Center"
                        IsActive="False"
                        Visibility="Collapsed" />
                </Grid>
                <ListView
                    x:Name="DiffLinesList"
                    Grid.Row="1"
                    AutomationProperties.Name="Selected file Git diff"
                    Background="{StaticResource AppBackgroundBrush}"
                    BorderBrush="{StaticResource AppLineBrush}"
                    BorderThickness="1"
                    IsItemClickEnabled="False"
                    IsTabStop="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollMode="Enabled"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="IsTabStop" Value="False" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="20" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:GitDiffLineView">
                            <Grid
                                MinHeight="20"
                                Padding="0"
                                Background="{x:Bind Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource AppSurfaceBrush}">
                                    <TextBlock
                                        Padding="6,2"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Right"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{StaticResource AppFaintBrush}"
                                        Text="{x:Bind OldLine}" />
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}">
                                    <TextBlock
                                        Padding="6,2"
                                        HorizontalAlignment="Stretch"
                                        TextAlignment="Right"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{StaticResource AppFaintBrush}"
                                        Text="{x:Bind NewLine}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="2"
                                    MinWidth="520"
                                    Padding="8,2"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{x:Bind Foreground}"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Text}"
                                    TextWrapping="NoWrap" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <InfoBar
            x:Name="ReviewError"
            Grid.Row="3"
            Margin="0,10,0,0"
            IsClosable="True"
            IsOpen="False"
            Severity="Error"
            Title="Git review could not continue" />
    </Grid>
</ContentDialog>
