<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="CodexMeterTray.Views.IntegrationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">
    <Grid Padding="24,20,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="12,0,0,0" Spacing="2">
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="Integrations" />
                <TextBlock
                    Foreground="{StaticResource AppMutedBrush}"
                    MaxLines="1"
                    Text="Add, configure, and remove the capabilities Codex can use."
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <CommandBar Grid.Column="1" Background="Transparent" DefaultLabelPosition="Collapsed">
                <AppBarButton
                    x:Name="RefreshButton"
                    AutomationProperties.Name="Refresh integrations"
                    Click="RefreshButton_Click"
                    Icon="Refresh"
                    Label="Refresh"
                    ToolTipService.ToolTip="Refresh integrations" />
                <AppBarButton
                    x:Name="OpenConfigButton"
                    AutomationProperties.Name="Open advanced Codex configuration"
                    Click="OpenConfigButton_Click"
                    Icon="OpenFile"
                    Label="Advanced config"
                    ToolTipService.ToolTip="Open advanced config" />
            </CommandBar>
        </Grid>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Margin="0,8,0,10"
            IsClosable="True"
            IsOpen="False" />

        <Grid Grid.Row="2">
            <TabView x:Name="IntegrationTabs" IsAddTabButtonVisible="False">
                <TabViewItem x:Name="SkillsTab" Header="Skills" IsClosable="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,8,0,12" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox
                                x:Name="SkillSearchBox"
                                AutomationProperties.Name="Search skills"
                                QueryIcon="Find"
                                TextChanged="SkillSearchBox_TextChanged"
                                PlaceholderText="Search skills" />
                            <Button
                                x:Name="NewSkillButton"
                                Grid.Column="1"
                                AutomationProperties.Name="Create a personal skill"
                                Click="NewSkillButton_Click"
                                Content="New skill" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListView
                                x:Name="SkillsList"
                                AutomationProperties.Name="Codex skills"
                                IsItemClickEnabled="False"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource AppLineBrush}" BorderThickness="0,0,0,1">
                                            <Grid Padding="12,11" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Foreground="{Binding StateBrush}" Text="{Binding StateText}" />
                                                    </Grid>
                                                    <TextBlock
                                                        Foreground="{StaticResource AppMutedBrush}"
                                                        MaxLines="2"
                                                        Text="{Binding Description}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{StaticResource AppFaintBrush}"
                                                        Text="{Binding Metadata}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                                    <Button
                                                        AutomationProperties.Name="{Binding ToggleAutomationName}"
                                                        Click="SkillToggleButton_Click"
                                                        Content="{Binding ToggleLabel}"
                                                        Tag="{Binding}" />
                                                    <Button
                                                        AutomationProperties.Name="{Binding EditAutomationName}"
                                                        Click="EditSkillButton_Click"
                                                        Content="Edit"
                                                        Tag="{Binding}"
                                                        Visibility="{Binding EditVisibility}" />
                                                    <Button
                                                        AutomationProperties.Name="{Binding RemoveAutomationName}"
                                                        Click="RemoveSkillButton_Click"
                                                        Content="Remove"
                                                        Tag="{Binding}"
                                                        Visibility="{Binding EditVisibility}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel
                                x:Name="SkillsEmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="6"
                                Visibility="Collapsed">
                                <FontIcon HorizontalAlignment="Center" FontSize="28" Glyph="&#xE8F1;" />
                                <TextBlock FontWeight="SemiBold" Text="No skills found" />
                                <TextBlock Foreground="{StaticResource AppMutedBrush}" Text="Try another search or create a personal skill." />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            x:Name="SkillsCountText"
                            Grid.Row="2"
                            Margin="8,10,0,0"
                            FontSize="12"
                            Foreground="{StaticResource AppFaintBrush}" />
                    </Grid>
                </TabViewItem>

                <TabViewItem x:Name="PluginsTab" Header="Plugins" IsClosable="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,8,0,12" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox
                                x:Name="PluginSearchBox"
                                AutomationProperties.Name="Search plugins"
                                QueryIcon="Find"
                                TextChanged="PluginSearchBox_TextChanged"
                                PlaceholderText="Search plugins" />
                            <ComboBox
                                x:Name="PluginFilterBox"
                                Grid.Column="1"
                                AutomationProperties.Name="Filter plugins"
                                MinWidth="110"
                                SelectedIndex="0"
                                SelectionChanged="PluginFilterBox_SelectionChanged">
                                <ComboBoxItem Content="All" />
                                <ComboBoxItem Content="Installed" />
                                <ComboBoxItem Content="Available" />
                            </ComboBox>
                            <Button
                                x:Name="BrowsePluginsButton"
                                Grid.Column="2"
                                AutomationProperties.Name="Browse available plugins"
                                Click="BrowsePluginsButton_Click"
                                Content="Browse" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListView
                                x:Name="PluginsList"
                                AutomationProperties.Name="Codex plugins"
                                IsItemClickEnabled="False"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource AppLineBrush}" BorderThickness="0,0,0,1">
                                            <Grid Padding="12,11" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Foreground="{Binding StateBrush}" Text="{Binding StateText}" />
                                                    </Grid>
                                                    <TextBlock
                                                        Foreground="{StaticResource AppMutedBrush}"
                                                        MaxLines="2"
                                                        Text="{Binding Description}"
                                                        TextTrimming="CharacterEllipsis"
                                                        TextWrapping="Wrap" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{StaticResource AppFaintBrush}"
                                                        Text="{Binding Metadata}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="{Binding ActionAutomationName}"
                                                    Click="PluginActionButton_Click"
                                                    Content="{Binding ActionLabel}"
                                                    IsEnabled="{Binding CanManage}"
                                                    Tag="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel
                                x:Name="PluginsEmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="6"
                                Visibility="Collapsed">
                                <FontIcon HorizontalAlignment="Center" FontSize="28" Glyph="&#xECAA;" />
                                <TextBlock FontWeight="SemiBold" Text="No plugins found" />
                                <TextBlock Foreground="{StaticResource AppMutedBrush}" Text="Change the filter or search another name." />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            x:Name="PluginsCountText"
                            Grid.Row="2"
                            Margin="8,10,0,0"
                            FontSize="12"
                            Foreground="{StaticResource AppFaintBrush}" />
                    </Grid>
                </TabViewItem>

                <TabViewItem x:Name="McpTab" Header="MCP servers" IsClosable="False">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,8,0,12" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox
                                x:Name="McpSearchBox"
                                AutomationProperties.Name="Search MCP servers"
                                QueryIcon="Find"
                                TextChanged="McpSearchBox_TextChanged"
                                PlaceholderText="Search MCP servers" />
                            <Button
                                x:Name="ReloadMcpButton"
                                Grid.Column="1"
                                AutomationProperties.Name="Reload MCP servers"
                                Click="ReloadMcpButton_Click"
                                Content="Reload" />
                            <Button
                                x:Name="AddMcpButton"
                                Grid.Column="2"
                                AutomationProperties.Name="Add an MCP server"
                                Click="AddMcpButton_Click"
                                Content="Add server" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListView
                                x:Name="McpList"
                                AutomationProperties.Name="Configured MCP servers"
                                IsItemClickEnabled="False"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource AppLineBrush}" BorderThickness="0,0,0,1">
                                            <Grid Padding="12,11" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="3">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Foreground="{Binding StateBrush}" Text="{Binding StateText}" />
                                                    </Grid>
                                                    <TextBlock
                                                        Foreground="{StaticResource AppMutedBrush}"
                                                        Text="{Binding Endpoint}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{StaticResource AppFaintBrush}"
                                                        Text="{Binding Metadata}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                                    <Button
                                                        AutomationProperties.Name="{Binding EditAutomationName}"
                                                        Click="EditMcpButton_Click"
                                                        Content="{Binding EditLabel}"
                                                        IsEnabled="{Binding CanEdit}"
                                                        Tag="{Binding}" />
                                                    <Button
                                                        AutomationProperties.Name="{Binding RemoveAutomationName}"
                                                        Click="RemoveMcpButton_Click"
                                                        Content="Remove"
                                                        Tag="{Binding}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel
                                x:Name="McpEmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="6"
                                Visibility="Collapsed">
                                <FontIcon HorizontalAlignment="Center" FontSize="28" Glyph="&#xE968;" />
                                <TextBlock FontWeight="SemiBold" Text="No MCP servers found" />
                                <TextBlock Foreground="{StaticResource AppMutedBrush}" Text="Add a local command or remote HTTP server." />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            x:Name="McpCountText"
                            Grid.Row="2"
                            Margin="8,10,0,0"
                            FontSize="12"
                            Foreground="{StaticResource AppFaintBrush}" />
                    </Grid>
                </TabViewItem>
            </TabView>

            <Grid
                x:Name="BusyOverlay"
                Background="#66000000"
                Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <ProgressRing Width="32" Height="32" IsActive="True" />
                    <TextBlock x:Name="BusyText" Text="Refreshing integrations…" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
